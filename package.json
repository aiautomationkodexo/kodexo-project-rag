{
  "name": "portfolio-knowledge-rag",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "seed:admin": "node --env-file-if-exists=.env.local scripts/seed-admin.mts",
    "verify:cloud": "node --env-file-if-exists=.env.local scripts/verify-deployment.mts",
    "build:sql": "node scripts/build-setup-sql.mts",
    "db:link": "supabase link",
    "db:diff": "supabase db push --linked --dry-run",
    "db:status": "supabase migration list --linked",
    "db:push": "cat supabase/.temp/project-ref && supabase db push --linked",
    "config:push": "node --env-file-if-exists=.env.local ./node_modules/.bin/supabase config push",
    "buckets:push": "node --env-file-if-exists=.env.local ./node_modules/.bin/supabase seed buckets",
    "types:db": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts.tmp && mv src/lib/supabase/database.types.ts.tmp src/lib/supabase/database.types.ts || (rm -f src/lib/supabase/database.types.ts.tmp; exit 1)"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.2",
    "next": "16.3.4",
    "nodemailer": "^10.0.0",
    "openai": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
