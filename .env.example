# Copy to .env.local and fill in. See SETUP.md for where each value comes from.

# ── Supabase: public (safe in the browser bundle) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Current key naming. Replaces the legacy ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Exact origin, NO trailing slash. Used to build magic-link redirect URLs.
# MUST byte-match supabase/config.toml's site_url and its redirect allow-list —
# Supabase compares origins as strings and SILENTLY falls back to site_url when
# redirect_to is not allow-listed, which surfaces only as "sign-in doesn't work".
#
# There is no code fallback any more: unset, this throws. And it is inlined at
# BUILD time, so on Vercel it must be set for the environment that builds, not
# only the one that runs.
NEXT_PUBLIC_SITE_URL=https://<your-deployment-origin>

# ── Supabase: server only ───────────────────────────────────────────────────
# PRD §15.7: never prefix NEXT_PUBLIC_, never import from a client component.
# Bypasses RLS. Replaces the legacy SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=sb_secret_...

# ── Pipeline ────────────────────────────────────────────────────────────────
# Guards /api/process and /api/finalize. Any long random string:
#   openssl rand -hex 32
INTERNAL_SECRET=

# Base URL the app uses to call ITSELF for the processing fan-out.
# Falls back to NEXT_PUBLIC_SITE_URL, then to VERCEL_URL. No localhost default:
# that silently produced ECONNREFUSED on every dispatch and left documents in
# 'queued' forever, because both callers swallow fetch failures by design.
# Set it explicitly if Vercel Deployment Protection is on — a self-call to
# VERCEL_URL is then answered by a 401 login page instead of the route.
INTERNAL_BASE_URL=https://<your-deployment-origin>

# 'http'   — production path: one function invocation per document, each with
#            its own maxDuration and memory budget.
# 'inline' — run the pipeline in-process. For local dev and tests with no
#            server running. Identical processing core either way.
PIPELINE_MODE=http

# ── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Optional override. Defaults to a current small model in src/lib/ai/openai.ts.
# Set to gpt-4o-mini to restore the PRD §1 choice with no code change.
# OPENAI_CHAT_MODEL=

# ── Seed (npm run seed:admin) ───────────────────────────────────────────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=

# ── Email (Google SMTP + App Password) ──────────────────────────────────────
# ONE credential, TWO consumers:
#   1. GoTrue's SMTP password for magic links. NOT read by the app at all — it
#      reaches Supabase via `npm run config:push`, which is why that script
#      shells the CLI through `node --env-file-if-exists=.env.local`. Push with
#      SMTP_PASSWORD unset and you write an EMPTY password to the project.
#   2. The completion email in src/lib/email/, over nodemailer.
#
# Unset is a VALID state: the completion email logs a warning and no-ops, and
# the project still finalizes (PRD §15.9). Magic links, however, fall back to
# Supabase's built-in sender at ~2/hour, which is unusable.
#
# Deviation from PRD §1 (Resend): Resend cannot deliver to anyone but the
# account owner until a sending domain is verified via SPF/DKIM, and we have no
# DNS access. These names are provider-neutral so switching later is a config
# change, not a code change.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# The full Google address. App Passwords need 2-Step Verification enabled, and
# a Workspace admin can disable them org-wide.
SMTP_USER=
# The 16-character App Password, NOT the account password.
SMTP_PASSWORD=
# Google rewrites the From header to the authenticated account, so this must be
# SMTP_USER or a verified "Send mail as" alias on it.
EMAIL_FROM=

# ── Transcription (T7) ──────────────────────────────────────────────────────
# Required only if audio/video is uploaded; every other format ignores it.
# Audio and video are capped at 200 MB (documents stay at 50 MB) — Deepgram
# fetches the file from a signed Storage URL, so the bytes never pass through
# this app. Supabase's GLOBAL storage limit must be >= 200 MB or the bucket
# silently clamps; see SETUP.md.
DEEPGRAM_API_KEY=

# ── Provided by the platform ────────────────────────────────────────────────
# CRON_SECRET=          # Vercel provides this automatically in production
